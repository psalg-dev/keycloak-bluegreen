{
  "realm": "demo",
  "clientScopes": [
    {
      "name": "tenant",
      "description": "tenant claim (custom mapper replaces this built-in one once the provider JAR is in the image)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "tenant", "claim.name": "tenant", "jsonType.label": "String",
                      "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "k6-app",
      "description": "Relying party driven by the k6 load test",
      "enabled": true,
      "publicClient": false,
      "secret": "$(env:K6_APP_SECRET)",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://app.localtest.me/cb"],
      "attributes": { "post.logout.redirect.uris": "https://app.localtest.me/*" },
      "defaultClientScopes": ["profile", "email", "basic"],
      "optionalClientScopes": ["tenant"]
    }
  ]
}
