{
  "realm": "demo",
  "clientScopes": [
    {
      "name": "tenant",
      "description": "tenant claim from the user attribute (custom provider demo-tenant-mapper)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "demo-tenant-mapper",
          "config": {}
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "k6-app",
      "description": "Relying party driven by the k6 load test",
      "enabled": true,
      "publicClient": false,
      "secret": "$(env:K6_APP_SECRET)",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://app.localtest.me/cb"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://app.localtest.me/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "basic"
      ],
      "optionalClientScopes": [
        "tenant"
      ],
      "protocolMappers": [
        {
          "name": "login_ctx",
          "protocol": "openid-connect",
          "protocolMapper": "demo-login-context-mapper",
          "config": {}
        }
      ]
    },
    {
      "clientId": "admin-cli",
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "account",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
