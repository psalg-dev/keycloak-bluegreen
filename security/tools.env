# Pinned security tool images (sourced by scripts/security/lib.sh). Latest stable as of 2026-11-02.
# kcwarden is not an image: it is installed in the Jenkins image (images/jenkins/Dockerfile, KCWARDEN_VERSION).
CURL_IMAGE=curlimages/curl:8.23.0
TRIVY_IMAGE=aquasec/trivy:0.76.1
NUCLEI_IMAGE=projectdiscovery/nuclei:v3.11.1
NUCLEI_TEMPLATES_VERSION=10.5.1
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.17.0
# testssl.sh publishes no patch-level image tag; this digest of :3.2 is 3.2.4.
TESTSSL_IMAGE=ghcr.io/testssl/testssl.sh:3.2@sha256:07eef6f0a35ac86fddc28b5e81efbb6f1c009535d63cdfac43e8b20711e62df5
